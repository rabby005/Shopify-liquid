<style>
   h1{
        padding-top:{{ section.settings.padding_top }}rem;
        font-size:{{ section.settings.heading_font }}px;
}
</style>


<div class="page-width">
    <h1 style="text-align: {{ section.settings.heading_align }};"> {{ section.settings.Text_header }} </h1>
    <p> {{ section.settings.text_area }} </p>
    {% comment %} <p>{{ section.settings.num_ber }}</p> {% endcomment %}

    {% if section.settings.num_ber >0 %}
      {{ section.settings.num_ber }}
    {% endif %}
     
</div>

{% schema  %} 

{
    
    "name": "CHS",
    
    "settings": [
        {
            "type": "text",
            "id": "Text_header",
            "label": "Heading"
        },
        {
            "type": "textarea",
            "id": "text_area",
            "label": "Write pragraph",
            "default":"tall your brand story here"
        },
        {
            "type": "number",
            "id": "num_ber",
            "label": "Namber",
            "default":123
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding",
            "min": 2,
            "max": 100,
            "step": 2,
            "unit": "rem",
            "default":2
        },
        
        {
            "type": "select",
            "id": "heading_align",
            "label": "Heading align",
            "options": [
                {
                    "value": "left",
                    "label": "Left align"
                },
                {
                    "value": "center",
                    "label": "Center align"
                },
                {
                    "value": "right",
                    "label": "Right align"
                }
            ]
        }
    ],
    
    "blocks": [],

    "presets": [
        {
        "name": "CHS"
        }
    ]
}

{% endschema %}